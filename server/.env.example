# Copy to .env and fill in as each integration becomes available.
# Nothing below is required to run the server except the ORACLE_* block —
# unconfigured platform/AI integrations fail loudly with a clear "not
# configured" error instead of returning fake data.

JWT_SECRET="change-me-to-a-long-random-string"

# --- Oracle Autonomous Database (required) ---
# From the OCI console: DB instance -> "Database Connection" -> "Download
# Wallet", unzip it somewhere local, and point ORACLE_WALLET_LOCATION at
# that folder. ORACLE_CONNECT_STRING is one of the aliases in the wallet's
# tnsnames.ora (e.g. "mydb_high").
ORACLE_CONNECT_STRING=
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=

# --- Platform adapters (leave blank until you have real developer credentials) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Only used as a fallback/dev-testing token for a single hardcoded page. Real
# agents connect their own page via the /auth/facebook/start OAuth flow,
# which stores a per-agent token in the platform_connection table instead.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Must be added to the Facebook app's "Valid OAuth Redirect URIs" exactly as
# written here (App Dashboard -> Facebook Login for Business -> Settings).
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:4000/auth/facebook/callback

# --- Mobile app deep-link scheme (must match app.json "scheme") ---
APP_DEEP_LINK_SCHEME=lifesyclelive

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- AI provider (leave blank to use the built-in rule-based fallback) ---
# Set AI_PROVIDER=groq and fill GROQ_API_KEY to use Groq (fast + cheap, good
# default for now). anthropic/openai are wired the same way but not yet
# implemented — see services/aiService.ts.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

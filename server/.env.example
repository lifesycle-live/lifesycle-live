# Copy to .env and fill in as each integration becomes available.
# Nothing below is required to run the server except DATABASE_URL —
# unconfigured platform/AI integrations fail loudly with a clear "not
# configured" error instead of returning fake data.
#
# MODEL: the *_CLIENT_ID / *_CLIENT_SECRET pairs below identify YOUR developer
# app on each platform. They are NOT an agent's account. Each estate agent
# connects their OWN account in the mobile app ("Connect accounts" screen),
# which runs that platform's OAuth flow and stores a per-agent token in the
# platform_connection table. See docs/18-platform-integration-plan.md.

JWT_SECRET="change-me-to-a-long-random-string"

# --- Supabase Postgres (required) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# URI. Use the "Connection pooling" URI (host ...pooler.supabase.com, port
# 6543) and put your DB password in place of [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Mobile app deep-link scheme (must match app/app.json "scheme") ---
# OAuth callbacks redirect to <scheme>://connect-callback so the app can
# pick the flow back up after the platform's consent screen.
APP_DEEP_LINK_SCHEME=lifesyclelive

# --- Public URL this server is reachable at (e.g. your ngrok tunnel) ---
# Used to build the /go/:broadcastId lead-capture link (routes/leadCapture.ts)
# that Facebook/YouTube adapters post into comments/chat as the "drop your
# details here" call-to-action once a broadcast goes live. Leave blank to
# skip posting that CTA (comments/chat still get fetched normally either way).
PUBLIC_BASE_URL=https://your-tunnel-or-domain.example.com


# ============================================================================
# FACEBOOK LIVE  —  one-click publish: YES (feasible)
# ============================================================================
# Developer setup (one time, you):
#   1. developers.facebook.com -> Create App -> type "Business".
#   2. Add product "Facebook Login for Business".
#   3. Settings -> add this exact redirect to "Valid OAuth Redirect URIs":
#        http://localhost:4000/auth/facebook/callback
#   4. Permissions the app requests: pages_show_list, pages_read_engagement,
#      pages_manage_posts, publish_video  (needs App Review before non-testers
#      can use it in production).
#   5. Put App ID / App Secret below.
# Per-agent: the agent authorises a Facebook Page they manage; we store that
# Page's long-lived access token. Go-live = POST /{page-id}/live_videos.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:4000/auth/facebook/callback
# Dev-only shortcut: a single hardcoded Page token so you can test without the
# OAuth flow. Leave blank in any shared/prod deploy.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Only needed if the agent's Page lives under a Business Portfolio (Business
# Settings -> Accounts -> Pages) — the plain scope-based dialog above returns
# ZERO pages for those (confirmed 2026-09-13, no_managed_pages error even
# with auth_type=rerequest). Fix: App Dashboard -> Facebook Login for
# Business -> Configurations -> create one with permissions
# pages_show_list, pages_read_engagement, pages_manage_posts, publish_video
# -> Assets tab -> attach the Page -> paste its id here.
FACEBOOK_LOGIN_CONFIG_ID=


# ============================================================================
# YOUTUBE LIVE  —  one-click publish: YES (feasible, implemented)
# ============================================================================
# Developer setup (one time, you):
#   1. console.cloud.google.com -> new project.
#   2. "APIs & Services" -> Library -> enable "YouTube Data API v3".
#   3. "APIs & Services" -> Credentials -> Create credentials -> OAuth client
#      ID -> Application type "Web application".
#   4. Add this exact URI to "Authorized redirect URIs":
#        http://localhost:4000/auth/youtube/callback
#   5. OAuth consent screen: add scope .../auth/youtube.force-ssl; while the
#      app is "Testing" add each agent's Google account as a test user, or
#      submit for verification for open sign-up.
#   6. Put client ID / secret below.
# Per-agent: the agent authorises their channel; we store the refresh token.
# The channel must have live streaming enabled (youtube.com/features) and no
# active strikes. Go-live = liveBroadcasts/liveStreams insert + bind.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/youtube/callback
# unlisted | private | public  (privacy of every broadcast we create)
YOUTUBE_PRIVACY_STATUS=unlisted
# Single-channel dev shortcut: `npm run youtube:auth` prints one here so you
# can test before the per-agent flow lands. Leave blank in shared/prod.
YOUTUBE_REFRESH_TOKEN=


# ============================================================================
# ZOOM  —  one-click publish: PARTIAL (per-agent OAuth; needs a paid plan)
# ============================================================================
# Developer setup (one time, you):
#   1. marketplace.zoom.us -> Develop -> Build App -> "General App" -> pick
#      "User-managed" when asked how the app is managed (NOT Server-to-Server,
#      NOT Admin-managed).
#   2. Redirect URL + add to allow-list. Zoom REQUIRES HTTPS here — plain
#      http://localhost does not work, use an https tunnel (e.g. ngrok) in
#      dev: https://<your-tunnel>/auth/zoom/callback
#   3. Scopes tab: search "meeting" and "user" and add the granular
#      equivalents of meeting:write / meeting:read / user:read — Zoom's
#      current UI names them meeting:write:meeting, meeting:read:meeting,
#      user:read:user (exact names can drift; search is the source of truth).
#   4. Put client ID / secret below.
# Per-agent: the agent authorises their Zoom user; we store the OAuth
# access+refresh token. Go-live = create meeting/webinar with "live streaming
# to a custom service" (RTMP) enabled — that setting requires the agent's Zoom
# plan to be Pro or higher AND the feature toggled on in their account.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=http://localhost:4000/auth/zoom/callback


# ============================================================================
# LINKEDIN  —  one-click publish: NO (assisted-only, identity connect only)
# ============================================================================
# LinkedIn Live requires going through an approved third-party broadcast
# partner or a manual RTMP-relay eligibility review — not a direct API call
# this app can drive. "Connecting" LinkedIn here only links identity via
# "Sign In with LinkedIn using OpenID Connect" (scope openid profile) for the
# assisted workflow. See docs/04-technical-feasibility.md.
# Developer setup (one time, you):
#   1. www.linkedin.com/developers/apps -> Create app.
#   2. Products tab -> add "Sign In with LinkedIn using OpenID Connect".
#   3. Auth tab -> add redirect URL: http://localhost:4000/auth/linkedin/callback
#   4. Put client ID / secret below.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:4000/auth/linkedin/callback


# ============================================================================
# INSTAGRAM  —  one-click publish: NO (assisted-only, API cannot start a Live)
# ============================================================================
# There is NO Instagram API to start, stop, or read comments on a Live video.
# The agent starts the Live in the Instagram app themselves. "Connecting"
# Instagram here only links their IG Business account (via Facebook Login,
# scope instagram_basic + a linked Page) for identity + post-broadcast
# follow-up — not live capture. Uses the Facebook app above; no separate
# credentials. See docs/18-platform-integration-plan.md and docs/04.
INSTAGRAM_ENABLED=false


# ============================================================================
# TIKTOK  —  one-click publish: NO (assisted-only, Live API is partner-gated)
# ============================================================================
# TikTok's LIVE API (start stream / read live chat) is closed — apply at
# developers.tiktok.com for the "Live" product; approval needs a real use case
# and the account typically needs 1,000+ followers to go live at all. Login
# Kit OAuth (scope user.info.basic) works for identity now; that's all we can
# wire until/unless Live access is granted.
#   Redirect: http://localhost:4000/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:4000/auth/tiktok/callback


# --- AI provider (leave blank to use the built-in rule-based fallback) ---
# Set AI_PROVIDER=groq and fill GROQ_API_KEY to use Groq (fast + cheap, good
# default for now). anthropic/openai are wired the same way but not yet
# implemented — see services/aiService.ts.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Team-only registration; leave unset to disable account creation.
REGISTRATION_INVITE_CODE=

# X: OAuth 2.0 confidential Web App; PKCE S256, identity connection only.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://localhost:4000/auth/x/callback
